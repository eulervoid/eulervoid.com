{
    "name": "eulervoid.com",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "start": "deno run -A .output/server/index.mjs",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "typecheck": "tsc --noEmit",
        "check": "deno task typecheck && deno task fmt:check && deno task lint",
        "deploy": "deno task build && deno run --allow-read=dist --allow-env --allow-run=op src/scripts/deploy.ts"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/react-pacer": "^0.22.1",
        "@tanstack/react-router": "^1.170.17",
        "@tanstack/react-router-devtools": "^1.167.0",
        "@tanstack/react-start": "^1.168.27",
        "hls.js": "^1.6.16",
        "motion": "^12.42.2",
        "nanoid": "^5.1.16",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-player": "^3.4.0",
        "remark-gfm": "^4.0.1",
        "schema-dts": "^2.0.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.2",
        "vite": "^8.1.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "sharp": "^0.35.3",
        "typescript": "^7.0.2",
        "vite-imagetools": "^10.0.1"
    }
}
